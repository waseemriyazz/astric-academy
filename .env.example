APP_NAME="Astryx Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Admin User Credentials (used by AdminUserSeeder)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# SQLite concurrency tuning (defaults already applied in code; override only if needed)
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=wal
# DB_SYNCHRONOUS=normal

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Open Router API Key (for AI Tutor chatbot)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# ============================================
# URL CONFIGURATION
# ============================================

# BACKEND_URL must be PUBLICLY accessible for Easebuzz/PayGlocal callbacks — this is
# where the Laravel API actually runs, NOT the React frontend's domain.
# Development: run `ngrok http 8000` and set to https://abc123.ngrok.io
# Production: set to https://portal.astryxacademy.com (same host as PORTAL_URL below —
# the Laravel backend serves the API, admin panel, and student portal all together)
BACKEND_URL=http://localhost:8000

# FRONTEND_URL = where the browser is after payment redirects from backend
# Development: http://localhost:5173
# Production: https://astryxacademy.com
FRONTEND_URL=http://localhost:5173

# PORTAL_URL = student dashboard login page
# Development: http://localhost:8000
# Production: https://portal.astryxacademy.com
PORTAL_URL=http://localhost:8000

# Payment callback URLs sent to Easebuzz / PayGlocal
# Leave empty to auto-generate from BACKEND_URL
PAYMENT_SUCCESS_URL=
PAYMENT_FAILURE_URL=
PAYGLOCAL_CALLBACK_URL=

# ============================================
# PAYMENT GATEWAY
# ============================================
# Which gateway is actually used at checkout is controlled from the admin
# Payment Gateways page (/admin/gateways), stored in the payment_gateway_configs
# table — not by these env vars. These values are only picked up once, the
# first time PaymentGatewayConfigSeeder runs, to seed initial credentials.
# After that, edit credentials via the admin page; changing these env vars
# will have no effect on an already-seeded gateway.

EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test

# Minutes a payment can sit pending/processing before the payments:expire-stale
# scheduled command reconciles it against Easebuzz's Transaction API. Keep this
# comfortably longer than Easebuzz's own checkout session timeout.
EASEBUZZ_PENDING_EXPIRY_MINUTES=30

# PayGlocal authenticates via a signed JWS token (RSA keypair), not a key+salt.
# PAYGLOCAL_PRIVATE_KEY is ours (generate it ourselves); PAYGLOCAL_PUBLIC_KEY is
# ours too, but the copy PayGlocal holds to verify our signed requests and to
# sign their callbacks back to us. Multi-line PEM values are awkward in .env —
# consider leaving these blank and entering them directly via the admin page.
PAYGLOCAL_MERCHANT_ID=
PAYGLOCAL_PRIVATE_KID=
PAYGLOCAL_PUBLIC_KID=
PAYGLOCAL_PRIVATE_KEY=
PAYGLOCAL_PUBLIC_KEY=
PAYGLOCAL_ENV=test
